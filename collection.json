{
  "info": {
    "_postman_id": "kharcha-pani-api-v2",
    "name": "Kharcha Pani - Expense Tracker API Collection",
    "description": "Complete Postman collection for manual and automated API testing of Kharcha Pani REST APIs (FastAPI backend). Includes Categories, Expenses, Budgeting, Dashboard & Health endpoints with pre-configured variables and tests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000",
      "type": "string",
      "description": "Backend API Base URL (default: http://127.0.0.1:8000 or your Render/Cloud URL)"
    },
    {
      "key": "apiKey",
      "value": "dev-shared-access-key-kharcha-pani",
      "type": "string",
      "description": "Shared access key sent via X-App-Key header"
    },
    {
      "key": "categoryId",
      "value": "1",
      "type": "string",
      "description": "Default category ID for testing"
    },
    {
      "key": "createdCategoryId",
      "value": "1",
      "type": "string",
      "description": "Auto-populated by 'Create Category' test script"
    },
    {
      "key": "expenseId",
      "value": "1",
      "type": "string",
      "description": "Default expense ID for testing"
    },
    {
      "key": "createdExpenseId",
      "value": "1",
      "type": "string",
      "description": "Auto-populated by 'Create Expense' test script"
    }
  ],
  "auth": {
    "type": "noauth"
  },
  "item": [
    {
      "name": "0. Health & System",
      "item": [
        {
          "name": "0.1 Root API Info",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/",
              "host": ["{{baseUrl}}"],
              "path": [""]
            },
            "description": "Returns basic API metadata, docs URLs, and version."
          },
          "response": []
        },
        {
          "name": "0.2 Liveness Health Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Backend status is ok\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"ok\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Unprotected liveness check endpoint to verify backend service is up and running."
          },
          "response": []
        },
        {
          "name": "0.3 Database Readiness Check",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Database connection is ok\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql(\"ok\");",
                  "    pm.expect(jsonData.database).to.eql(\"connected\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health/db",
              "host": ["{{baseUrl}}"],
              "path": ["health", "db"]
            },
            "description": "Verifies active database connection with a test SQL query."
          },
          "response": []
        }
      ]
    },
    {
      "name": "1. Categories",
      "item": [
        {
          "name": "1.1 Get All Categories",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Response has success flag\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});",
                  "if (jsonData.data && jsonData.data.length > 0) {",
                  "    pm.collectionVariables.set(\"categoryId\", jsonData.data[0].id);",
                  "    console.log(\"Saved categoryId:\", jsonData.data[0].id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-App-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"]
            },
            "description": "Fetches all categories with expense counts."
          },
          "response": []
        },
        {
          "name": "1.2 Create Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 Created\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Category created successfully\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "    pm.expect(jsonData.data.name).to.exist;",
                  "});",
                  "if (jsonData.data && jsonData.data.id) {",
                  "    pm.collectionVariables.set(\"createdCategoryId\", jsonData.data.id);",
                  "    console.log(\"Saved createdCategoryId:\", jsonData.data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "X-App-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Entertainment & Movies\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories"]
            },
            "description": "Creates a new custom expense category."
          },
          "response": []
        },
        {
          "name": "1.3 Update Category",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Category name updated\", function () {",
                  "    pm.expect(jsonData.success).to.be.true;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "X-App-Key",
                "value": "{{apiKey}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Entertainment & Weekend Trips\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{createdCategoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", "{{createdCategoryId}}"]
            },
            "description": "Renames an existing category by its ID."
          },
          "response": []
        },
        {
          "name": "1.4 Delete Category (Safe Check / Guarded)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-App-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{createdCategoryId}}?cascade=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", "{{createdCategoryId}}"],
              "query": [
                {
                  "key": "cascade",
                  "value": "false",
                  "description": "If false and category has linked expenses, it prevents accidental deletion (returns 409 conflict)."
                }
              ]
            },
            "description": "Attempts safe deletion of a category. Fails safely if linked expenses exist without cascade=true or reassign_to."
          },
          "response": []
        },
        {
          "name": "1.5 Delete Category with Reassign",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-App-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{createdCategoryId}}?reassign_to={{categoryId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", "{{createdCategoryId}}"],
              "query": [
                {
                  "key": "reassign_to",
                  "value": "{{categoryId}}",
                  "description": "Target category ID to reassign linked expenses before deleting"
                }
              ]
            },
            "description": "Reassigns linked expenses to another category and deletes the specified category."
          },
          "response": []
        },
        {
          "name": "1.6 Force Delete Category (Cascade)",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "X-App-Key",
                "value": "{{apiKey}}",
                "type": "text"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/categories/{{createdCategoryId}}?cascade=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "categories", "{{createdCategoryId}}"],
              "query": [
                {
                  "key": "cascade",
                  "value": "true",
                  "description": "Deletes category and ALL linked expenses permanently"
                }
              ]
            },
            "description": "Force deletes a category and all expenses linked to it."
          },
          "response": []
        }
      ]
