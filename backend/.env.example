# App Environment Configuration
APP_ENV=development
DEBUG=true

# ==========================================
# DATABASE CONFIGURATION
# ==========================================
# For Local PostgreSQL development:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kharchapani_db

# For Local SQLite fallback (zero-config):
# DATABASE_URL=sqlite+aiosqlite:///./kharchapani.db

# For Production / Supabase deployment:
# DATABASE_URL=postgresql+asyncpg://postgres:[PASSWORD]@db.xxxxx.supabase.co:5432/postgres?sslmode=require
# DATABASE_URL_POOLED=postgresql+asyncpg://postgres:[PASSWORD]@db.xxxxx.supabase.co:6543/postgres?sslmode=require

# ==========================================
# CORS & API CONFIGURATION
# ==========================================
ALLOWED_ORIGINS=http://localhost:3000,https://kharcha-pani.vercel.app
API_V1_PREFIX=/api/v1

# ==========================================
# JWT & AUTHENTICATION (Phase 2)
# ==========================================
JWT_SECRET_KEY=generate-a-strong-random-secret-key-for-jwt-signing-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_HOURS=24

# ==========================================
# GOOGLE OAUTH 2.0 / OPENID CONNECT (Phase 2)
# ==========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ==========================================
# EMAIL SERVICE CONFIGURATION
# ==========================================
# Provider Selection: "gmail" or "resend"
EMAIL_PROVIDER=gmail
FRONTEND_URL=http://localhost:3000

# --- Option A: Gmail SMTP Provider ---
GMAIL_SMTP_HOST=smtp.gmail.com
GMAIL_SMTP_PORT=587
GMAIL_SMTP_USERNAME=your-email@gmail.com
GMAIL_SMTP_PASSWORD=your-16-char-google-app-password
GMAIL_FROM_EMAIL=your-email@gmail.com
GMAIL_FROM_NAME=KharchaPani

# --- Option B: Resend Provider (https://resend.com) ---
RESEND_API_KEY=re_123456789abcdef
RESEND_FROM_EMAIL=onboarding@resend.dev
RESEND_FROM_NAME=KharchaPani

# --- Token Expiry Settings (Minutes) ---
EMAIL_VERIFICATION_EXPIRE_MINUTES=30
PASSWORD_RESET_EXPIRE_MINUTES=30

# ==========================================
# LEGACY V1 ACCESS GATE (Backward Compatibility)
# ==========================================
APP_ACCESS_KEY=change-me-to-a-long-random-value

# Server Port
PORT=8000
